export org.babyfish.jimmer.sql.kt.model.TreeNode

RecursiveTree {
    name
    childNodes*
}

input TreeNodeInput {
    #allScalars(TreeNode)
    id!
    /**
     * Associated parent id
     */
    id(parent)
}

FlatTreeNode {
    #allScalars
    flat(parent) {
        as(^ -> parent) {
            #allScalars
        }
        id(parent) as grandParentId
    }
}

TreeNodeFoldInsideFlatView {
    id
    name
    flat(parent) {
        fold(key) {
            name
        }
    }
}

TreeNodeFlatJoinView {
    id
    name
    !fetchType(JOIN_ALWAYS)
    flat(parent) {
        name as parentName
    }
}
